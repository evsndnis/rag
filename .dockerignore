# локальное Python-окружение
.venv
# папка с git-историей — внутри образа не нужна
.git
# workflow-файлы CI/CD — на проде не запускаются
.github
# кеш скомпилированных .pyc
__pycache__
*.pyc
# кеш pytest
.pytest_cache
# тесты в проде не запускаем
tests
# тут могут быть секреты — внутрь образа не тащим
.env
.env.*
# документация для людей, не для контейнера
README.md
# описание стека — внутри образа не нужно
docker-compose.yml